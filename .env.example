# Set to "true" only after the client signs and the site launches (turns on indexing).
SITE_INDEXABLE=false
NEXT_PUBLIC_SITE_URL=https://jamaican-jerk-house-demo.vercel.app

# Inquiry emails (catering + contact). Without these the forms run in demo mode and send nothing.
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_TO_EMAIL=
# Optional: shown as a mailto fallback if a send fails.
NEXT_PUBLIC_CONTACT_EMAIL=
